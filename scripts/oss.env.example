# OSS 备份配置模板。实际文件放在服务器 /etc/emotion-backup/oss.env（chmod 600），不要提交到仓库。
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com

# 是否加密：0=不加密（默认，上传 .db.gz）；1=GPG AES256 加密（上传 .db.gz.gpg）
# 开启加密时，需要 /etc/emotion-backup/gpg-passphrase 口令文件（600），
# 并建议在服务器之外离线保存一份口令，丢失则加密备份无法恢复。
BACKUP_ENCRYPT=0
